        <item name="colorSecondary">@color/cavaliers_accent</item>
        <item name="colorOnSecondary">@color/cavaliers_background</item>
        <item name="colorSecondaryContainer">@color/cavaliers_key_operator</item>
        <item name="colorOnSecondaryContainer">@color/cavaliers_text_primary</item>
        <item name="colorSurface">@color/cavaliers_surface</item>
        <item name="colorOnSurface">@color/cavaliers_text_primary</item>
        <item name="colorSurfaceVariant">@color/cavaliers_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/cavaliers_text_secondary</item>
        <item name="colorSurfaceContainer">@color/cavaliers_surface</item>
        <item name="colorSurfaceContainerLow">@color/cavaliers_surface</item>
        <item name="colorSurfaceContainerLowest">@color/cavaliers_background</item>
        <item name="colorSurfaceContainerHigh">@color/cavaliers_surface_variant</item>
