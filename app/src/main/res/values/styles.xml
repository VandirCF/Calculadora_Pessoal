    </style>

    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Switch</item>
    </style>

    <style name="ThemeOverlay.App.Switch" parent="">
        <item name="colorPrimary">?attr/calc_accent</item> <!-- on: track -->
        <item name="colorOnPrimary">?attr/calc_background</item> <!-- on: thumb -->
        <item name="colorSurfaceVariant">?attr/calc_key_number</item> <!-- off: track -->
        <item name="colorOutline">?attr/calc_text_secondary</item>
    </style>

    <style name="RobotoFontCondensedLight" parent="android:Widget.TextView">
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="RobotoFontCondensedMedium" parent="android:Widget.TextView">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CalculatorButton" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/circle</item>
        <item name="android:textColor">?attr/text_color</item>
        <item name="android:textSize">@dimen/calculator_button_text_size</item>
        <item name="android:layout_marginHorizontal" tools:targetApi="o">@dimen/button_horizontal_margin</item>
        <item name="android:layout_marginVertical" tools:targetApi="o">@dimen/button_vertical_margin</item>
        <item name="android:includeFontPadding">false</item>
        <!-- cancel out material3 -->
        <item name="backgroundTint">@null</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- used in landscape layouts in place of CalculatorButton -->
    <style name="CalculatorButton.Small">
        <item name="android:textSize">@dimen/calculator_button_text_size</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="CalculatorButton.Function">
        <item name="android:textSize">@dimen/calculator_button_function_text_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/circle_ripple_only</item>
        <!-- PI breaks without this -->
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Popup Menu -->
    <style name="Widget.Material3.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/rounded</item>
    </style>



</resources>