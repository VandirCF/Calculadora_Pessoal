<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base of both themes: always dark, Material 3. Colors come from the per-theme styles below. -->
    <style name="Theme.Calc.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowLightStatusBar" tools:ignore="NewApi">false</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>
    </style>

    <!-- Tema Flamengo -->
    <style name="Theme.Calc.Flamengo" parent="Theme.Calc.Base">
        <item name="android:statusBarColor">@color/flamengo_display</item>
        <item name="android:navigationBarColor">@color/flamengo_background</item>
        <item name="android:colorBackground">@color/flamengo_background</item>

        <!-- semantic tokens -->
        <item name="calc_background">@color/flamengo_background</item>
        <item name="calc_surface">@color/flamengo_surface</item>
        <item name="calc_surface_variant">@color/flamengo_surface_variant</item>
        <item name="calc_display_background">@color/flamengo_display</item>
        <item name="calc_primary">@color/flamengo_primary</item>
        <item name="calc_secondary">@color/flamengo_secondary</item>
        <item name="calc_accent">@color/flamengo_accent</item>
        <item name="calc_text_primary">@color/flamengo_text_primary</item>
        <item name="calc_text_secondary">@color/flamengo_text_secondary</item>
        <item name="calc_key_number">@color/flamengo_key_number</item>
        <item name="calc_key_operator">@color/flamengo_key_operator</item>
        <item name="calc_key_function">@color/flamengo_key_function</item>
        <item name="calc_key_danger">@color/flamengo_key_danger</item>
        <item name="calc_key_financial">@color/flamengo_key_financial</item>
        <item name="calc_key_enter">@color/flamengo_key_enter</item>
        <item name="calc_outline">@color/flamengo_outline</item>
        <item name="calc_logo">@drawable/logo_flamengo</item>
        <item name="calc_error">@color/calculation_error_color</item>

        <!-- legacy attributes used by the inherited layouts and drawables -->
        <item name="foreground_color">@color/flamengo_display</item>
        <item name="background_color">@color/flamengo_background</item>
        <item name="popup_background_color">@color/flamengo_surface_variant</item>
        <item name="history_background_color">@color/flamengo_surface</item>
        <item name="text_color">@color/flamengo_text_primary</item>
        <item name="text_second_color">@color/flamengo_text_secondary</item>
        <item name="text_third_color">@color/flamengo_accent</item>
        <item name="text_category_color">@color/flamengo_accent</item>
        <item name="button_color">@color/flamengo_key_number</item>
        <item name="button_symbol_color">@color/flamengo_key_operator</item>
        <item name="button_clear_color">@color/flamengo_key_danger</item>
        <item name="button_equals_color">@color/flamengo_key_enter</item>
        <item name="button_ripple_color">@color/flamengo_ripple</item>
        <item name="separator_color">@color/flamengo_background</item>
        <item name="about_button_color">@color/flamengo_key_number</item>

        <!-- Material components (dialogs, menus, switches, text buttons) -->
        <item name="colorPrimary">@color/flamengo_accent</item>
        <item name="colorOnPrimary">@color/flamengo_background</item>
        <item name="colorPrimaryContainer">@color/flamengo_primary</item>
        <item name="colorOnPrimaryContainer">@color/flamengo_text_primary</item>
        <item name="colorSecondary">@color/flamengo_accent</item>
        <item name="colorOnSecondary">@color/flamengo_background</item>
        <item name="colorSecondaryContainer">@color/flamengo_key_operator</item>
        <item name="colorOnSecondaryContainer">@color/flamengo_text_primary</item>
        <item name="colorSurface">@color/flamengo_surface</item>
        <item name="colorOnSurface">@color/flamengo_text_primary</item>
        <item name="colorSurfaceVariant">@color/flamengo_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/flamengo_text_secondary</item>
        <item name="colorSurfaceContainer">@color/flamengo_surface</item>
        <item name="colorSurfaceContainerLow">@color/flamengo_surface</item>
        <item name="colorSurfaceContainerLowest">@color/flamengo_background</item>
        <item name="colorSurfaceContainerHigh">@color/flamengo_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/flamengo_surface_variant</item>
        <item name="colorOutline">@color/flamengo_outline</item>
        <item name="colorOutlineVariant">@color/flamengo_outline</item>
        <item name="colorError">@color/calculation_error_color</item>
    </style>

