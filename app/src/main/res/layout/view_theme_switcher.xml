<?xml version="1.0" encoding="utf-8"?>
<!-- The two team shields side by side, one shield width apart. Tapping a shield switches the theme.
     Each shield is 28 dp wide inside a 36 dp target: 4 + 20 + 4 dp = one shield width of space. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/themeSwitcher"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/themeFlamengo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_flamengo" />

    <Space
        android:layout_width="20dp"
        android:layout_height="1dp" />

    <ImageView
        android:id="@+id/themeCavaliers"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_cavaliers" />
</LinearLayout>
